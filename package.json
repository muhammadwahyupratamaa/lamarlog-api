{
  "name": "applyflow-api",
  "version": "1.0.0",
  "description": "ApplyFlow personal job application tracker API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "NODE_ENV=test TEST_DATABASE_URL=\"${TEST_DATABASE_URL:-postgres://applyflow:applyflow_dev_password@localhost:5435/applyflow_test}\" NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_ENV=test TEST_DATABASE_URL=\"${TEST_DATABASE_URL:-postgres://applyflow:applyflow_dev_password@localhost:5435/applyflow_test}\" NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "db:migrate": "sequelize-cli db:migrate --config sequelize.config.cjs --env \"${NODE_ENV:-development}\" --migrations-path src/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config sequelize.config.cjs --env \"${NODE_ENV:-development}\" --migrations-path src/migrations",
    "db:migrate:status": "sequelize-cli db:migrate:status --config sequelize.config.cjs --env \"${NODE_ENV:-development}\" --migrations-path src/migrations"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammadwahyupratamaa/applyflow-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/env.js"],
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"]
  },
  "bugs": {
    "url": "https://github.com/muhammadwahyupratamaa/applyflow-api/issues"
  },
  "homepage": "https://github.com/muhammadwahyupratamaa/applyflow-api#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
