# development uses http://localhost:5173 when CORS_ORIGIN is omitted; production requires it.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://applyflow:applyflow_dev_password@localhost:5435/applyflow
TEST_DATABASE_URL=postgres://applyflow:applyflow_dev_password@localhost:5435/applyflow_test
POSTGRES_TEST_DB=applyflow_test
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173
